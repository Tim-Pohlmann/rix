<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rix</AssemblyName>
    <RootNamespace>Rix</RootNamespace>
    <Version>0.5.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Rix.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Not in the Microsoft.AspNetCore.App shared framework, so it needs an explicit version.
         Kept at >= 10.0.12: earlier 10.0.x pull a Microsoft.OpenApi with advisory GHSA-v5pm-xwqc-g5wc. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <!-- The files `rix initialize` writes into a target repo, one folder per setup, laid out as
       they land in the repo. Embedded so a released single-file binary carries them itself, with
       no network fetch at init time. Named by path rather than MSBuild's dotted default, which
       would lose where one folder ends and the next begins. -->
  <PropertyGroup>
    <!-- Off so the SDK accepts the skills embedded twice. It also stops the SDK embedding *.resx
         files by itself, and rix has none: one added later needs an EmbeddedResource item. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Cli/Templates/**/*" LogicalName="Rix.Cli.Templates/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The factory's skills a second time, where Claude Code looks for them: it reads only
         .claude/skills, while pi and opencode read .agents/skills. Embedding one file twice needs
         EnableDefaultEmbeddedResourceItems off (above), or the SDK rejects it as a duplicate. -->
    <EmbeddedResource Include="Cli/Templates/Factory/.rix/agent-home/.agents/skills/**/*" LogicalName="Rix.Cli.Templates/Factory/.rix/agent-home/.claude/skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
