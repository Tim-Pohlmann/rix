{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result rix job prints and writes to result.json.",
  "type": "object",
  "required": [
    "status"
  ],
  "anyOf": [
    {
      "properties": {
        "status": {
          "const": "success"
        },
        "pendingPrRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string"
              },
              "baseBranch": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "bundleFile": {
                "type": "string"
              }
            },
            "required": [
              "branch",
              "baseBranch",
              "title",
              "body",
              "bundleFile"
            ],
            "additionalProperties": false
          }
        },
        "pendingPushRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string"
              },
              "baseBranch": {
                "type": "string"
              },
              "bundleFile": {
                "type": "string"
              }
            },
            "required": [
              "branch",
              "baseBranch",
              "bundleFile"
            ],
            "additionalProperties": false
          }
        },
        "costUsd": {
          "type": "number"
        },
        "durationSeconds": {
          "type": "integer"
        }
      },
      "required": [
        "status",
        "pendingPrRequests",
        "pendingPushRequests",
        "costUsd",
        "durationSeconds"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "status": {
          "const": "failure"
        },
        "error": {
          "type": "string"
        },
        "costUsd": {
          "type": "number"
        },
        "durationSeconds": {
          "type": "integer"
        }
      },
      "required": [
        "status",
        "error",
        "costUsd",
        "durationSeconds"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "status": {
          "const": "setupFailure"
        },
        "error": {
          "type": "string"
        },
        "costUsd": {
          "type": "number"
        },
        "durationSeconds": {
          "type": "integer"
        }
      },
      "required": [
        "status",
        "error",
        "costUsd",
        "durationSeconds"
      ],
      "additionalProperties": false
    }
  ]
}
